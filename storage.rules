
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // WARNING: This is a temporary, insecure rule for debugging.
    // It allows any authenticated user to read and write any file.
    // This will be replaced with secure rules.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
